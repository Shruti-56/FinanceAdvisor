<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity"
    android:background="@drawable/img1">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finance Advisor"
        android:textSize="24sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/salaryEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Monthly Salary"
        android:inputType="numberDecimal"
        android:background="#EEEEEE"
        android:padding="12dp"
        android:layout_below="@id/titleTextView"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/investmentsEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Monthly Investments (e.g., SIPs)"
        android:inputType="numberDecimal"
        android:background="#EEEEEE"
        android:padding="12dp"
        android:layout_below="@id/salaryEditText"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/expenses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/salaryEditText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="78dp"
        android:background="#EEEEEE"
        android:hint="Total Expenses"
        android:inputType="numberDecimal"
        android:padding="12dp" />

    <Button
        android:id="@+id/submit1"
        android:layout_width="134dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="261dp"
        android:layout_marginEnd="16dp"
        android:text="Submit"
        android:backgroundTint="@color/black"
        android:textColor="@color/white"/>

    <ImageView
        android:id="@+id/barGraphImageView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_below="@id/investmentsEditText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="128dp"
        android:scaleType="fitXY"
        android:src="@drawable/graph" />

    <Button
        android:id="@+id/chatButton"
        android:layout_width="134dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/barGraphImageView"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="16dp"
        android:background="#4285F4"
        android:text="Chat with AI"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/totalSavingsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:text="Total Savings: $0.00"
        android:textColor="#000000"
        android:textSize="18sp" />
</RelativeLayout>
